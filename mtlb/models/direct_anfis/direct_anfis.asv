function x_next = direct_anfis(X, U, dt)
% X: [y vy psi r]
% U: [vx delta Mtv]
    
% Unpack state and inputs
C = num2cell(X);
[y vy psi r] = deal(C{:});
C = num2cell(U);
[vx st mz] = deal(C{:});

% Load models
persistent direct_anfis;
if(isempty(direct_anfis))
    S = load('direct_anfis.mat', 'direct_anfis');
    direct_anfis = S.direct_anfis;
end

% Build ANFIS input vector and normalize
Xin = [vy r vx st mz];
Xin_n = (Xin - direct_anfis.norm.mu) ./ direct_anfis.norm.sigma;

% Evaluate learned dynamics
dvy = evalfis(direct_anfis.vy.fis, Xin_n);
dr  = evalfis(direct_anfis.r.fis,  Xin_n);

% Convert to derivatives
vy_dot = dvy / dt;
r_dot  = dr  / dt;

% Kinematics
y_dot   = cos(psi) * vy + vx*cos(psi) * psi;
psi_dot = 

% Model matrix (y, vy, psi, r)
if vx < 2
    A = zeros(4); 
    B = zeros(4,1);
else
    A = [0, cos(psi), vx*cos(psi), 0;
         0, -(Cf*cos(delta)+Cr)/(m*vx), 0, -((lf*Cf*cos(delta)-lr*Cr)/(m*vx))+vx;
         0, 0, 0, 1;
         0, -(lf*Cf*cos(delta)-lr*Cr)/(Iz*vx), 0, -(lf*lf*Cf*cos(delta)+lr*lr*Cr)/(Iz*vx)];
    B = [0;
         Cf*cos(delta)/m;
         0;
         lf*Cf*cos(delta)/Iz];
end

% Discretize matrix
M = [A B; zeros(1,5)];
exp_matrix = expm(M*dt);
C = exp_matrix(1:4,1:4);
D = exp_matrix(1:4,5);

% Next state
x_next = C*X + D*delta;

end